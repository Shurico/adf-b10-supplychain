									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": "select refreshed as status from mastertable where tableName= 'salesitems'",
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
